NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://carepath:carepath@localhost:5432/carepath
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
FRONTEND_ORIGIN=http://localhost:5173
API_BASE_URL=http://localhost:4000

# S3-compatible object storage. Health records require these in production.
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=carepath-health-records
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Razorpay test/live credentials. Keep secrets server-side.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional; set to true only for local development without PostgreSQL/S3/payment credentials.
DEMO_MODE=false

# Identity verification policy
EMAIL_TOKEN_TTL_MS=1800000
PHONE_OTP_TTL_MS=300000
PHONE_OTP_MAX_ATTEMPTS=5
PHONE_OTP_RESEND_COOLDOWN_MS=30000

# Transactional email provider. The provider must accept POST JSON {to,template,token,expiresAt}.
EMAIL_PROVIDER_URL=
EMAIL_PROVIDER_API_KEY=
EMAIL_VERIFICATION_TEMPLATE=carepath-email-verification

# Transactional SMS provider. The provider must accept POST JSON {to,message}.
SMS_PROVIDER_URL=
SMS_PROVIDER_API_KEY=

# Authorized UIDAI-compatible provider. Never place these values in frontend VITE_* variables.
AADHAAR_ENV=sandbox
AADHAAR_API_URL=
AADHAAR_CLIENT_ID=
AADHAAR_CLIENT_SECRET=
AADHAAR_CALLBACK_URL=

# Frontend map tile provider
VITE_MAPTILER_API_KEY=your_maptiler_api_key_here

# Google Gemini API key
GEMINI_API_KEY=

